PORT=3000
# 같은 Wi-Fi의 실기기에서 접근하려면 0.0.0.0을 사용합니다.
HOST=0.0.0.0
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# 단일 workspace에 한정되지 않은 API 키를 쓰는 경우에만 입력합니다.
ANTHROPIC_WORKSPACE_ID=
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_MS=45000
# 로컬 데모: 서버 전체의 하루 유료 분석 시도 수. 실패도 차감, 한국 자정 초기화.
AI_DAILY_LIMIT=5
# 재시작해도 횟수를 유지합니다. 단일 서버 프로세스에서만 사용하세요.
AI_USAGE_FILE=.data/relation-usage.json
# Flutter Web: flutter run -d chrome --web-port=8080
# 네이티브 Flutter는 브라우저 CORS 제한을 받지 않습니다.
# 경고: *로 바꾸면 모든 웹 출처를 허용합니다. 신뢰할 수 있는 로컬 개발에서만 사용하세요.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
